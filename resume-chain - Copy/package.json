    "@types/mocha": "^10.0.10",
    "chai": "^4.2.0",
    "ethers": "^6.14.0",
    "hardhat": "^2.26.3",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
